@startuml
!pragma layout smetana
left to right direction
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam roundcorner 0
skinparam classBackgroundColor #F2F8FC
skinparam classBorderColor #21435D
skinparam ArrowColor #3B556B
skinparam packageBackgroundColor #F8FAFC
skinparam nodesep 45
skinparam ranksep 65
hide circle
package "utilidades" {
class ErroDeRegra {
--
}
}
package "modelo" {
class Paciente {
- __responsavel
+ {field} responsavel: Pessoa | None {property, get, set}
--
+ __init__(nome: str, celular: str, cpf: str, data_nascimento: date)
+ definir_responsavel(responsavel: Pessoa)
+ pode_atender_sozinho(data: date): bool
+ descricao()
}
abstract class Pessoa {
- __celular
- __cpf
- __data_nascimento
- __nome
+ {field} nome: str {property, get, set}
+ {field} celular: str {property, get, set}
+ {field} cpf: str {property, get, set}
+ {field} data_nascimento: date {property, get, set}
--
+ __init__(nome: str, celular: str, cpf: str, data_nascimento: date)
+ idade_em(data: date): int
{abstract} + descricao(): str
+ __str__()
}
class Profissional {
- __especialidade
- __registro
+ {field} especialidade: str {property, get, set}
+ {field} registro: str {property, get, set}
--
+ __init__(nome: str, celular: str, cpf: str, data_nascimento: date, especialidade: str, registro: str)
+ descricao()
}
}
abstract class ABC <<externo>>
class Exception <<externo>>
Exception <|-- ErroDeRegra
Pessoa <|-- Paciente
ABC <|-- Pessoa
Pessoa <|-- Profissional
Paciente --> "0..1" Pessoa : responsavel
Paciente ..> ErroDeRegra : cria
Pessoa ..> ErroDeRegra : cria
Profissional ..> ErroDeRegra : cria
@enduml
